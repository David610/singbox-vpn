# Single authoritative source for the pinned release-build container and
# its declared GLIBC ABI baseline. Sourced by BOTH the real release build
# (.github/workflows/release.yml's "build" job) and the cheap pre-tag
# smoke job (.github/workflows/ci.yml's "release-container-smoke" job,
# via deploy/lib/build-release-x86_64.sh --environment-check) — one file,
# two consumers, no separate copy of the digest/baseline to drift.
#
# Plain KEY=value (no quotes, no spaces around `=`), same convention as
# deploy/lib/versions.env: `source`-able by bash, and appendable as-is to
# $GITHUB_ENV in a GitHub Actions step.
#
# v1.0.0-rc.3 incident: binaries built on ubuntu-latest inherited its own
# (much newer, unpinned/drifting) glibc ABI and failed to even start on
# an AlmaLinux 8 VPS. RELEASE_BUILD_IMAGE below is a digest-pinned
# AlmaLinux 8.10 image used ONLY as a conservative BUILD environment to
# guarantee a GLIBC_2.28-or-older ABI baseline — it does not make
# AlmaLinux 8 a supported OS (see docs/SUPPORTED_PRODUCT.md's "Binary ABI
# baseline" section). deploy/lib/build-release-x86_64.sh asserts the
# build container's actual glibc matches RELEASE_GLIBC_BASELINE exactly
# before compiling anything, so a drifted image digest fails fast instead
# of silently shipping a binary with a higher ABI requirement.
RELEASE_BUILD_IMAGE=almalinux@sha256:9f355ae942d6a6c0561f0771dc053a2cfae9580fc45fa4252756db7c7e80c09f
RELEASE_GLIBC_BASELINE=2.28
