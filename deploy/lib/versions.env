# Single authoritative source for pinned release inputs. Sourced by
# deploy/almalinux/install.sh, deploy/lib/fast-gate.sh, and
# .github/workflows/ci.yml's singbox-validate job — do not hardcode any
# of these values a second time anywhere else. Bumping SINGBOX_VERSION
# MUST update the matching checksum(s) in the same commit (see
# docs/FINAL_PRODUCTION_AUDIT.md P0-8); every consumer fails closed if a
# value is missing rather than silently skipping verification.
#
# Plain KEY=value (no quotes, no spaces around `=`) so this file is
# simultaneously: `source`-able by bash, and appendable as-is to
# $GITHUB_ENV in a GitHub Actions step (`cat deploy/lib/versions.env >>
# "$GITHUB_ENV"`) — one file, two consumers, no translation step to drift.

# v1.0 supported/tested architecture (docs/SUPPORTED_PRODUCT.md). The
# installer/release pipeline also builds aarch64 as a secondary target;
# x86_64 is the only one CI validates end-to-end with a real sing-box
# handshake.
SUPPORTED_ARCH=x86_64

# Pinned upstream sing-box release. sing-box does not publish a detached
# checksums.txt for every release, so SINGBOX_SHA256_AMD64/ARM64 below
# are the trusted-comparison target when it doesn't — hand-computed from
# the real asset bytes and re-verified against a second independent
# download before pinning (docs/FINAL_PRODUCTION_AUDIT.md P0-8).
SINGBOX_VERSION=1.13.19
SINGBOX_SHA256_AMD64=ef88a9e577d474210867bd708933d042e9b70106529df2656182c9db90106aa1
SINGBOX_SHA256_ARM64=7fe3597a95a3c5ad67477b1d7653b9ce097e0be7c676758eba1fcf558f353d57

# Pinned sigstore/cosign release, used to verify GitHub artifact
# attestations anonymously against the public Sigstore Rekor
# transparency log (see verify_release_attestation() in install.sh,
# deploy/almalinux/install.sh, and deploy/almalinux/update.sh —
# docs/SUPPLY_CHAIN_SECURITY.md explains why `gh attestation verify` was
# replaced: it refuses to run at all without `gh auth login`/GH_TOKEN,
# even for a public repository, which a fresh install has no way to
# provide). Checksums hand-computed from the real asset bytes and
# cross-checked against cosign's own published checksums file before
# pinning (same process as SINGBOX_SHA256_* above). install.sh cannot
# source this file (it runs before any repo checkout exists), so it
# carries its own copy of these three values — kept in sync by
# deploy/lib/tests/test-release-reproducibility.sh.
COSIGN_VERSION=3.1.3
COSIGN_SHA256_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
COSIGN_SHA256_ARM64=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a
