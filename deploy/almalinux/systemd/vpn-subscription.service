[Unit]
Description=vpn compatibility subscription HTTP service (loopback only)
After=network.target

# See sing-box.service's own Restart=/StartLimit* comments for the full
# rationale — the same reasoning applies here: on-failure (below) covers
# a plain crash, an unclean signal (SIGKILL included), and a startup
# failure (e.g. a missing/invalid REALITY key file — see
# services/subscription/src/main.rs, which refuses to start and serve
# broken subscriptions rather than binding with bad data). An explicit,
# generous StartLimit means a burst of startup failures survives without
# the unit parking itself `failed` forever; vpn-service-watchdog.timer
# is the safety net if it ever does exhaust this budget.
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
User=vpn-subscription
Group=vpn-subscription
ExecStart=/usr/local/bin/vpn-subscription-svc --config /etc/vpn/deployment.toml
Restart=on-failure
RestartSec=2
# Production default is warnings/errors only — a successful subscription
# fetch is per-user activity metadata (which user, when, in what format;
# see services/subscription/src/lib.rs's `tracing::debug!("subscription
# served")` call) and is not retained by default. Failure diagnostics
# (rate-limit engagement, user-store load errors, render errors) are all
# logged at `warn`/`error` and are unaffected by this change. An operator
# troubleshooting a specific deployment can still see per-request success
# lines by temporarily overriding this, e.g.
# `systemctl edit vpn-subscription` with `Environment=RUST_LOG=debug` (or
# `=info`), then `systemctl restart vpn-subscription`.
Environment=RUST_LOG=warn
# Per-service journal rate limiting (systemd >= 240; does not touch
# /etc/systemd/journald.conf or any other unit). Conservative but not
# tight: this service sees at most a handful of requests/second even
# under nginx's own 5r/s-per-client cap (see the nginx vhost template),
# so 200 messages/30s comfortably covers real traffic plus a burst of
# errors, while still capping a scanner/error flood from filling the
# journal.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

# Never needs to write anywhere except read the user store (read-only
# from this service's perspective — vpn-admin, run as root, is the only
# writer) and bind loopback only, so this can be sandboxed tightly.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/vpn/compat/users /etc/vpn/compat/reality /etc/vpn/deployment.toml
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
IPAddressAllow=127.0.0.0/8 ::1/128
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
