[Unit]
Description=sing-box compatibility data plane (VLESS+REALITY, Hysteria2)
Documentation=https://sing-box.sagernet.org/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sing-box
Group=sing-box
ExecStartPre=/usr/local/bin/sing-box check -c /etc/vpn/compat/sing-box/config.json
ExecStart=/usr/local/bin/sing-box run -c /etc/vpn/compat/sing-box/config.json
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

# Binding 443/tcp+udp requires CAP_NET_BIND_SERVICE, not root — grant only
# that capability rather than running as root (spec §32).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. Documented exceptions:
#  - ProtectSystem=strict + explicit ReadOnlyPaths for the config dir
#    (sing-box only needs to *read* config/certs, never write there).
#  - No ProtectHome restriction needed (service user has no home).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/vpn/compat
# AF_NETLINK is required: sing-box opens a netlink socket to subscribe
# to route/interface change notifications (its network monitor, used
# for outbound-interface auto-detection) even without TUN configured.
# Without it here, the kernel rejects that socket() call with EAFNOSUPPORT
# ("address family not supported by protocol") and sing-box.service
# fails to start at all — caught on a real AlmaLinux install.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
