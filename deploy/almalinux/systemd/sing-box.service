[Unit]
Description=sing-box compatibility data plane (VLESS+REALITY, Hysteria2)
Documentation=https://sing-box.sagernet.org/
After=network-online.target
Wants=network-online.target

# StartLimitIntervalSec/StartLimitBurst were previously left at
# systemd's compiled-in default (10s / 5 restarts) — implicit, and far
# too tight for what this unit actually needs to survive: 5 restarts at
# a 2s RestartSec exhausts in ~10s, after which systemd marks the unit
# `failed` and STOPS retrying entirely, even automatically, until a
# human runs `systemctl reset-failed`. A boot-time race (e.g. a slower
# disk/cert-mount than usual, or network-online.target firing before
# routing is actually usable despite the Wants= above) can easily crash
# sing-box more than 5 times in its first 10 seconds and then simply
# never come back — indistinguishable from a real outage to every
# client, and invisible unless an operator happens to run `systemctl
# status`/`vpn doctor`. 8 restarts inside a 5-minute window is generous
# enough to absorb that kind of transient without ever looking like a
# permanent outage, while still giving up on a truly-broken config/
# binary well before it could meaningfully spam the journal (bounded
# further by LogRateLimitBurst below). Once the burst IS exhausted, this
# unit does not stay parked forever either —
# vpn-service-watchdog.timer (see that file) periodically clears a
# stuck `failed` state and asks systemd to try again, so "restart budget
# exhausted" is a throttle, never a dead end, without this unit's own
# Restart= directive ever spinning in a fast, uncapped loop.
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
User=sing-box
Group=sing-box
ExecStartPre=/usr/local/bin/sing-box check -c /etc/vpn/compat/sing-box/config.json
ExecStart=/usr/local/bin/sing-box run -c /etc/vpn/compat/sing-box/config.json
# Restart=on-failure already covers every crash path that matters here:
# a plain non-zero exit, an unclean signal (including SIGKILL — a kill
# -9 or an OOM kill is exactly as "unclean" to systemd as any other
# fatal signal), and ExecStartPre's own config-check failing before
# ExecStart ever runs (a bad config is never loaded live, per the
# ExecStartPre gate above — it just makes this a repeating failed START
# instead of a running process crashing later). See the [Unit] section
# above for the explicit StartLimitIntervalSec/StartLimitBurst this
# restart behavior operates within.
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

# Per-service journal rate limiting (systemd >= 240; does not touch
# /etc/systemd/journald.conf or any other unit). sing-box is the one
# internet-facing process here (TCP/443 + UDP/443) and its own config
# already logs at "warn" (see crates/compat-config/src/server.rs), so
# under normal operation this limit is never reached — it exists purely
# to cap a port-scanner/DPI-probe flood of rejected-handshake warnings
# from filling the journal, while 1000 messages/30s is generous enough
# that a real incident still leaves plenty to investigate.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

# Modest CPU scheduling priority bump, not real-time scheduling. On a
# 1-2 vCPU host, sing-box's Hysteria2/QUIC inbound is latency-sensitive
# userspace packet processing that competes with everything else on the
# box (nginx, sshd, cron, the admin/subscription binaries); upstream
# Hysteria guidance (https://v2.hysteria.network/docs/advanced/Performance/)
# explicitly cautions to raise priority moderately and only after
# testing, not to jump to SCHED_RR/FIFO, which could starve other
# processes on a shared host. -5 is deliberately conservative — enough
# to matter under contention, not enough to approach realtime.
Nice=-5

# Binding 443/tcp+udp requires CAP_NET_BIND_SERVICE, not root — grant only
# that capability rather than running as root (spec §32).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Cgroup resource protection (P8 — this project had none at all before).
# Deliberately conservative in the opposite direction from a typical
# "resource limit": the goal here is ONLY to stop a runaway/compromised
# sing-box process from being able to take the whole host down (starving
# sshd, cron, the admin/subscription binaries, or triggering the
# system-wide OOM killer, which picks victims with no regard for which
# process actually caused the pressure), never to constrain sing-box's
# own legitimate traffic handling. For a <=10-user deployment, sing-box's
# real steady-state CPU/memory/thread footprint is small and mostly flat
# regardless of load (Go's goroutine scheduler does not spawn one OS
# thread per connection), so every value below sits far above anything
# real usage should ever reach:
#   - MemoryHigh is a SOFT throttle (the kernel reclaims/pressures the
#     cgroup's memory harder as usage climbs past it) — it never kills
#     the process by itself, so it cannot manifest as a dropped VPN
#     connection the way a hard memory kill could.
#   - MemoryMax is the hard ceiling, set high enough (90% of total RAM)
#     that only a genuine leak or a deliberate memory-exhaustion attempt
#     would ever reach it — at that point cgroup-scoped OOM killing this
#     one service is a strictly better outcome than the alternative
#     (the kernel's global OOM killer choosing an arbitrary victim
#     process on the host, sing-box included, with no isolation at all).
#   - TasksMax bounds the number of threads/goroutine-backed OS tasks
#     this cgroup may create — 512 is generous for any real sing-box
#     workload at this scale and exists only to cap a fork-bomb-shaped
#     bug or exploit, not to constrain normal operation.
# Deliberately NOT added: CPUQuota. sing-box's Hysteria2/QUIC path does
# real per-packet crypto work and can legitimately need every available
# CPU cycle during a burst; any CPU quota tight enough to matter is
# exactly the kind of "protection" that would throttle real streaming/
# voice traffic and reproduce the silent-degradation failure class this
# project is trying to eliminate, not prevent it. Left unset on purpose.
MemoryHigh=75%
MemoryMax=90%
TasksMax=512

# Hardening. Documented exceptions:
#  - ProtectSystem=strict + explicit ReadOnlyPaths for the config dir
#    (sing-box only needs to *read* config/certs, never write there).
#  - No ProtectHome restriction needed (service user has no home).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/vpn/compat
# AF_NETLINK is required: sing-box opens a netlink socket to subscribe
# to route/interface change notifications (its network monitor, used
# for outbound-interface auto-detection) even without TUN configured.
# Without it here, the kernel rejects that socket() call with EAFNOSUPPORT
# ("address family not supported by protocol") and sing-box.service
# fails to start at all — caught on a real AlmaLinux install.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
# Added: this is the sole internet-facing process here (raw TCP/443 +
# UDP/443 traffic from untrusted clients), so the marginal hardening
# cost of these four is cheap insurance against a parser/codec bug in
# the data plane being escalated into something worse.
#   - SystemCallFilter=@system-service: systemd's curated allowlist for
#     ordinary daemons: covers socket/netlink/epoll/etc. (what sing-box
#     actually needs, including the AF_NETLINK monitor above) while
#     blocking syscall classes a network daemon has no business making
#     (reboot, mount, kexec, raw module loading, ...).
#   - RestrictSUIDSGID=true: this process never needs to create
#     setuid/setgid files.
#   - PrivateDevices=true: no device-file access is needed to terminate
#     TLS/QUIC and proxy traffic.
#   - ProtectProc=invisible: hides other processes' /proc/<pid> entries
#     from this unit; it has no legitimate reason to inspect them.
SystemCallFilter=@system-service
RestrictSUIDSGID=true
PrivateDevices=true
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
