[Unit]
Description=Recover sing-box/vpn-subscription from a parked failed state
Documentation=https://github.com/David610/singbox-vpn
After=sing-box.service vpn-subscription.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/vpn-service-watchdog

# Runs a handful of `systemctl` calls against already-defined units and
# nothing else — no config to read, no state to persist, no network
# access needed.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
