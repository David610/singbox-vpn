#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

VPN_ADMIN="${VPN_ADMIN:-/usr/local/bin/vpn-admin}"
STATE_DIR="${VPN_WEB_STATE_DIR:-/var/lib/singbox-vpn/web-users}"

die() {
  printf 'vpn-web-provision: %s\n' "$*" >&2
  exit 2
}

[[ $# -eq 2 ]] || die "usage: vpn-web-provision <provision|enable|disable> <supabase-user-uuid>"
action="$1"
external_id="$2"

[[ "$action" =~ ^(provision|enable|disable)$ ]] || die "unsupported action"
[[ "$external_id" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$ ]] \
  || die "invalid Supabase user id"
[[ -x "$VPN_ADMIN" ]] || die "vpn-admin not executable: $VPN_ADMIN"
command -v jq >/dev/null 2>&1 || die "jq is required"
command -v flock >/dev/null 2>&1 || die "flock is required"

install -d -m 0700 -o root -g root "$STATE_DIR"

# Serialize the external-id -> vpn-user mapping around create/read/apply so
# webhook retries and a simultaneous manual reconcile cannot mint duplicates.
exec 9>"$STATE_DIR/.web-provision.lock"
flock -x 9

state_file="$STATE_DIR/$external_id.json"

validate_state() {
  jq -e '
    (.id | type == "string" and length > 0) and
    (.subscription_url | type == "string" and startswith("https://")) and
    (.provisioning_url | type == "string" and startswith("https://"))
  ' "$1" >/dev/null
}

json_from_rotated_token() {
  local vpn_user_id="$1"
  local output sub_url path_and_query token origin provisioning_url

  # rotate-token intentionally prints the new bearer URL only once. Capture it
  # in-memory; do not echo the full command output to logs.
  output="$("$VPN_ADMIN" user rotate-token "$vpn_user_id")"
  sub_url="$(printf '%s\n' "$output" | grep -m1 -E '^  https://' | sed -e 's/^  //')" || true
  [[ "$sub_url" == https://*/sub/* ]] || die "could not recover subscription URL after token rotation"

  origin="${sub_url%%/sub/*}"
  path_and_query="${sub_url#*/sub/}"
  token="${path_and_query%%\?*}"
  [[ -n "$token" && "$token" != "$path_and_query" ]] || die "rotated subscription URL had no token/query boundary"

  # The existing server exposes the first-party schema at /v1/provision/{token}.
  # Keep this construction next to the helper's recovery path: normal first
  # creation still trusts vpn-admin's own provisioning_url JSON field.
  provisioning_url="$origin/v1/provision/$token"

  jq -cn \
    --arg id "$vpn_user_id" \
    --arg subscription_url "$sub_url" \
    --arg provisioning_url "$provisioning_url" \
    '{
      id: $id,
      enabled: true,
      subscription_url: $subscription_url,
      provisioning_url: $provisioning_url
    }'
}

case "$action" in
  provision)
    if [[ -f "$state_file" ]]; then
      validate_state "$state_file" || die "stored mapping is corrupt"
      cat "$state_file"
      exit 0
    fi

    vpn_name="web-${external_id//-/}"

    # Crash recovery: vpn-admin commits the user before this helper can persist
    # the web mapping. If the process dies in that narrow window, a retry sees
    # the deterministic internal name, rotates a fresh subscription token, and
    # records the existing VPN identity instead of creating a duplicate user.
    mapfile -t existing_ids < <(
      "$VPN_ADMIN" user list \
        | awk -v wanted="$vpn_name" 'NR > 1 && $2 == wanted { print $1 }'
    )

    if (( ${#existing_ids[@]} > 1 )); then
      die "multiple VPN users match the deterministic web account name; operator intervention required"
    fi

    if (( ${#existing_ids[@]} == 1 )); then
      json="$(json_from_rotated_token "${existing_ids[0]}")"
    else
      output="$("$VPN_ADMIN" user create --name "$vpn_name" --json)"
      json="${output#*\{}"
      json="{${json}"
    fi

    printf '%s\n' "$json" \
      | jq -e '
          (.id | type == "string" and length > 0) and
          (.subscription_url | type == "string" and startswith("https://")) and
          (.provisioning_url | type == "string" and startswith("https://"))
        ' >/dev/null \
      || die "vpn-admin returned an invalid provisioning contract"

    tmp="$(mktemp "$STATE_DIR/.web-user.XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$json" | jq -c '.' > "$tmp"
    chmod 0600 "$tmp"
    chown root:root "$tmp"
    mv "$tmp" "$state_file"
    trap - EXIT
    cat "$state_file"
    ;;

  enable|disable)
    [[ -f "$state_file" ]] || die "VPN mapping does not exist"
    validate_state "$state_file" || die "stored mapping is corrupt"
    vpn_user_id="$(jq -er '.id' "$state_file")"
    "$VPN_ADMIN" user "$action" "$vpn_user_id" >/dev/null
    jq -cn --arg id "$vpn_user_id" --arg action "$action" \
      '{id:$id, action:$action, ok:true}'
    ;;
esac
