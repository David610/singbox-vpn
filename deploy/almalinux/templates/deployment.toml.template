# /etc/vpn/deployment.toml — rendered once by install.sh from this
# template. Safe to hand-edit afterwards; install.sh never overwrites an
# existing file. See docs/ALMALINUX_DEPLOYMENT.md.

# Current on-disk deployment schema (DEPLOYMENT_SCHEMA_VERSION in
# crates/compat-config/src/deployment.rs). Fresh installs must start
# current; older files are upgraded only by `vpn-admin config migrate` on
# repair/update. deploy/lib/tests/test-node-identity.sh fails if this
# template and the Rust constant ever disagree.
schema_version = 2

# Stable node identity and role. Neither is ever rewritten by repair,
# update or migration. role = "exit" is an ordinary VPN exit; role =
# "relay" accepts authenticated first-hop traffic and forwards it ONLY to
# exits declared below ([[peer_endpoints]] on a relay access path).
node_id = "{{NODE_ID}}"
role = "{{NODE_ROLE}}"

public_host = "{{PUBLIC_HOST}}"
subscription_host = "{{SUBSCRIPTION_HOST}}"

[reality]
listen_port = 443
handshake_server = "{{REALITY_HANDSHAKE_SERVER}}"
handshake_port = 443

[hysteria2]
listen_port = 443
# Fixed-rate (Brutal) congestion control: leave commented out unless you
# have actually measured this VPS's sustained throughput with
# `vpn benchmark` (see docs/PERFORMANCE_OPTIMIZATION_PLAN.md). Both
# values must be set together, in Mbps, and should be your MEASURED
# sustained rate, not your provider's advertised/burst rate — setting
# these too high causes self-induced congestion, not a speedup.
# up_mbps = 100
# down_mbps = 100

[subscription]
listen_port = 9100
public_port = {{SUBSCRIPTION_PORT}}
