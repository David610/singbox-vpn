# /etc/nginx/conf.d/vpn-subscription.conf — fully managed by vpn1.
# Terminates public HTTPS for the subscription endpoint and proxies to
# the loopback-only Rust subscription service. install.sh regenerates
# this file from this template on EVERY run (not just the first) so it
# always reflects the current PUBLIC_HOST/SUBSCRIPTION_HOST — do not
# hand-edit the installed file, changes will be overwritten on the next
# install.sh/update.sh run. If you need custom nginx directives, add a
# separate file under /etc/nginx/conf.d/ rather than editing this one.
#
# Two separate TLS concerns, do not confuse them (see
# docs/ALMALINUX_DEPLOYMENT.md "Two independent TLS certificates"):
#   - THIS file terminates HTTPS for {{SUBSCRIPTION_HOST}}:{{SUBSCRIPTION_PORT}} (subscription API).
#   - Hysteria2's TLS is handled directly by sing-box for {{PUBLIC_HOST}}:443/udp
#     and has nothing to do with nginx.
#
# Rate limiting happens HERE, not in the Rust service: the Rust service
# sees every request as coming from 127.0.0.1 once it's behind this
# proxy, so its own per-IP limiter would collapse to one global bucket.
# nginx sees the real client IP because it terminates the actual client
# TCP connection, so this is the trustworthy place to do it.
limit_req_zone $binary_remote_addr zone=vpn_subscription:10m rate=5r/s;

server {
    listen {{SUBSCRIPTION_PORT}} ssl;
    listen [::]:{{SUBSCRIPTION_PORT}} ssl;
    server_name {{SUBSCRIPTION_HOST}};

    # Certbot (or your own ACME client) manages these — see
    # docs/ALMALINUX_DEPLOYMENT.md "Certificates" for the exact command.
    # install.sh refuses to enable this vhost until both files exist.
    ssl_certificate     /etc/letsencrypt/live/{{SUBSCRIPTION_HOST}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{SUBSCRIPTION_HOST}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Scoped to this vhost only — does not touch the global nginx.conf
    # `server_tokens` setting (which may still be on for other vhosts on
    # this host). Drops the nginx version number from the `Server:`
    # response header and from any error page, one less free fingerprint
    # for a scanner probing this endpoint.
    server_tokens off;

    location /sub/ {
        limit_req zone=vpn_subscription burst=10 nodelay;

        # /sub/<token> — the URI itself IS a bearer credential. Never let
        # it reach an access log (docs/FINAL_PRODUCTION_AUDIT.md P0-12):
        # a leaked/rotated log file must never be able to hand out a live
        # subscription token.
        access_log off;
        # nginx's rate limiter and upstream errors include the full request
        # URI in the error log by default. That URI contains the bearer
        # token, so this credential-bearing location may emit only critical
        # process-level failures, never request-level diagnostics.
        error_log /var/log/nginx/vpn-subscription-token-safe-error.log crit;

        proxy_pass http://127.0.0.1:{{SUBSCRIPTION_BACKEND_PORT}};
        proxy_set_header Host $host;
        proxy_http_version 1.1;

        # Subscription bodies carry live credentials — never let this
        # proxy or an intermediate cache serve a stale/cached copy.
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;

        # Deliberately not forwarding X-Forwarded-For/X-Real-IP: the
        # backend does not read them (see
        # docs/PRODUCTION_HARDENING_PLAN.md #8) — no client-controlled
        # header can spoof identity into the Rust service.
    }

    location /healthz {
        # Local diagnostics only — install.sh/health-check.sh/
        # acceptance-test.sh all probe this through `curl --resolve
        # HOST:PORT:127.0.0.1 https://HOST:PORT/healthz`, which makes a
        # real TLS connection (so certificate verification is fully
        # exercised, unlike `curl -k`) but the underlying TCP peer is
        # always 127.0.0.1 — so those checks pass unchanged. An
        # arbitrary Internet client hitting the public IP directly does
        # not match `allow 127.0.0.1`/`allow ::1` and gets 403, closing
        # off a no-auth endpoint that otherwise reveals nothing but does
        # not need to answer strangers.
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://127.0.0.1:{{SUBSCRIPTION_BACKEND_PORT}};
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}
