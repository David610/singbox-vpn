# Keep the Docker build context (repo root, see deploy/docker/Dockerfile) to
# source only — no build artifacts, no key material, no rendered configs.

.git
target/
**/target/

# Never send local/host secrets or rendered configs into a build context.
*.key
*.pem
**/reality/private.key
**/reality/public.key
**/hysteria/*.key
**/hysteria/*.pem
/etc/vpn/**

# Editor/OS noise
.DS_Store
*.swp
