# Files that bash, python or systemd parse on Linux must be LF even in a
# Windows checkout with core.autocrlf=true (I-27). Enforced by
# deploy/lib/tests/test-line-endings.sh.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.path text eol=lf
*.env text eol=lf
*.template text eol=lf
*.toml text eol=lf
bin/singbox-vpn-uninstall text eol=lf
