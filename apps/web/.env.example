# Public/build-time
NEXT_PUBLIC_APP_URL=https://vpn.example.com
NEXT_PUBLIC_PRODUCT_NAME=VPN
NEXT_PUBLIC_PRICE_DISPLAY=Monthly subscription

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_AUTOMATIC_TAX=false

# VPN provisioning
# 32 random bytes, base64 encoded: openssl rand -base64 32
VPN_CONFIG_ENCRYPTION_KEY=
VPN_PROVISION_HELPER=/usr/local/sbin/vpn-web-provision
VPN_ENTITLED_STATUSES=active,trialing

# Legal/support. Fill these before launch.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_VAT_ID=
SUPPORT_EMAIL=
